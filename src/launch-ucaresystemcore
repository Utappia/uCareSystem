set -e

# Resolve ucaresystem-core location
UCARE_CORE_CMD=""
if command -v ucaresystem-core >/dev/null 2>&1; then
    UCARE_CORE_CMD="ucaresystem-core"
elif [ -x "$(dirname "$0")/ucaresystem-core" ]; then
    UCARE_CORE_CMD="$(dirname "$0")/ucaresystem-core"
else
    echo "Error: ucaresystem-core was not found" >&2
    exit 1
fi

# Build command with pause-for-key at the end
# This ensures users can read final messages (reboot required, etc.)
COMMAND="$UCARE_CORE_CMD"
SKIP_WAIT=0

# Process arguments: collect all except --no-wait
for arg in "$@"; do
    if [ "$arg" = "--no-wait" ]; then
        SKIP_WAIT=1
    else
        COMMAND="$COMMAND \"$arg\""
    fi
done

# Add pause logic only for interactive terminals unless --no-wait was passed.
# In CI/non-interactive shells, read would fail and incorrectly return non-zero.
if [ "$SKIP_WAIT" -eq 0 ] && [ -t 0 ]; then
    COMMAND="$COMMAND; echo; read -r -p 'Press Enter to exit...'"
fi

# Execute with bash
exec bash -c "$COMMAND"
